{
  "name": "formora",
  "version": "0.1.0",
  "description": "TypeScript form rendering engine for interactive chat widgets",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "wasm"
  ],
  "scripts": {
    "build:wasm": "wasm-pack build --target bundler --out-dir wasm --out-name formora_js",
    "build:wasm:node": "wasm-pack build --target nodejs --out-dir wasm-node --out-name formora_js",
    "build:ts": "tsc",
    "build": "npm run build:wasm && npm run build:ts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules node_modules/.bin/jest"
  },
  "keywords": [
    "forms",
    "wasm",
    "chat",
    "llm",
    "webassembly"
  ],
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.3.0",
    "@types/node": "^20.0.0",
    "jest": "^29.0.0",
    "@jest/globals": "^29.0.0",
    "ts-jest": "^29.0.0"
  }
}
